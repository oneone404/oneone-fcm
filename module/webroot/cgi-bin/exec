#!/system/bin/sh
# Settings-only WebUI. Status reads never modify device settings.
DATA_DIR=/data/system
PK_BOOT_CONF="$DATA_DIR/fcm_pk_boot.conf"
MODDIR="${0%/*}/../.."
. "$MODDIR/common.sh"
STOCK_CONF="$MODDIR/stock_settings.conf"

set_data_permissions() {
    chmod 0644 "$1"
    chown system:system "$1" 2>/dev/null || true
    chcon u:object_r:system_data_file:s0 "$1" 2>/dev/null || true
}
read_pk_boot_config() {
    PK_GMS_BOOT=$(default_pk_boot)
    [ -f "$PK_BOOT_CONF" ] || return 0
    _value=$(tr -d ' \r\n' < "$PK_BOOT_CONF")
    case "$_value" in true|1) PK_GMS_BOOT=true ;; false|0) PK_GMS_BOOT=false ;; esac
}
get_pk_state() {
    PK_GMS_CTRL=$(read_powerkeeper_control) || PK_GMS_CTRL=unsupported
}
disarm_powerkeeper_gms() {
    ensure_powerkeeper_backup "$STOCK_CONF" || return 1
    content call --uri content://com.miui.powerkeeper.configure/SimpleSettings/misc --method PUT_misc --arg gms_control --extra value:s:false >/dev/null 2>&1 || return 1
    # Same conservative Play Store policy as the boot service.
    content update --uri content://com.miui.powerkeeper.configure/userTable --bind bgControl:s:miuiAuto --where "pkgName='com.android.vending' AND userId=0" >/dev/null 2>&1 || return 1
    iptables -F gms_wall 2>/dev/null || true
    ip6tables -F gms_wall 2>/dev/null || true
}
fail() {
    echo '{"status":"error","message":"Action failed; original settings backup retained"}'
    exit 1
}
json_string() {
    # Properties may contain quotes/control characters; escape JSON safely.
    printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g;s/"/\\"/g'
}
case "${1:-status}" in
    status|load_status|get_status)
        read_pk_boot_config; get_pk_state
        _idle=$(cmd deviceidle whitelist 2>/dev/null); _idle_status=$?
        GMS_DOZE=unknown
        if [ "$_idle_status" -eq 0 ]; then
            GMS_DOZE=false
            printf '%s\n' "$_idle" | grep -q 'com.google.android.gms' && GMS_DOZE=true
        fi
        _firmware=$(json_string "$(getprop ro.build.version.incremental)")
        _version=$(sed -n 's/^version=//p' "$MODDIR/module.prop" | head -n1)
        printf '{"status":"ok","version":"%s","firmware":"%s","doze":"%s","gms_parity":{"powerkeeper_gms_control":"%s","boot_apply":%s}}\n' "$_version" "$_firmware" "$GMS_DOZE" "$PK_GMS_CTRL" "$PK_GMS_BOOT"
        ;;
    set_pk_gms|toggle_pk_gms)
        case "$2" in
            false) disarm_powerkeeper_gms || fail ;;
            true) restore_powerkeeper_state "$STOCK_CONF" >/dev/null 2>&1 || fail ;;
            *) fail ;;
        esac
        get_pk_state
        printf '{"status":"ok","powerkeeper_gms_control":"%s"}\n' "$PK_GMS_CTRL"
        ;;
    set_pk_gms_boot)
        case "$2" in true|false) TARGET="$2" ;; *) fail ;; esac
        [ "$TARGET" != true ] || disarm_powerkeeper_gms || fail
        printf '%s\n' "$TARGET" > "$PK_BOOT_CONF.tmp.$$" || fail
        set_data_permissions "$PK_BOOT_CONF.tmp.$$"
        mv -f "$PK_BOOT_CONF.tmp.$$" "$PK_BOOT_CONF" || fail
        get_pk_state
        printf '{"status":"ok","boot_apply":%s,"powerkeeper_gms_control":"%s"}\n' "$TARGET" "$PK_GMS_CTRL"
        ;;
    *) fail ;;
esac
