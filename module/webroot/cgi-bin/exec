#!/system/bin/sh
# Settings-only WebUI. Status reads never modify device settings.
DATA_DIR=/data/system
PK_BOOT_CONF="$DATA_DIR/fcm_pk_boot.conf"
MODDIR="${0%/*}/../.."
. "$MODDIR/common.sh"
. "$MODDIR/lib/framework.sh"
STOCK_CONF="$MODDIR/stock_settings.conf"

set_data_permissions() {
    chmod 0644 "$1"
    chown system:system "$1" 2>/dev/null || true
    chcon u:object_r:system_data_file:s0 "$1" 2>/dev/null || true
}
read_pk_boot_config() {
    PK_GMS_BOOT=$(default_pk_boot)
    [ -f "$PK_BOOT_CONF" ] || return 0
    _value=$(tr -d ' \r\n' < "$PK_BOOT_CONF")
    case "$_value" in true|1) PK_GMS_BOOT=true ;; false|0) PK_GMS_BOOT=false ;; esac
}
get_pk_state() {
    PK_GMS_CTRL=$(read_powerkeeper_control) || PK_GMS_CTRL=unsupported
}
disarm_powerkeeper_gms() {
    ensure_powerkeeper_backup "$STOCK_CONF" || return 1
    content call --uri content://com.miui.powerkeeper.configure/SimpleSettings/misc --method PUT_misc --arg gms_control --extra value:s:false >/dev/null 2>&1 || return 1
    # Same conservative Play Store policy as the boot service.
    content update --uri content://com.miui.powerkeeper.configure/userTable --bind bgControl:s:miuiAuto --where "pkgName='com.android.vending' AND userId=0" >/dev/null 2>&1 || return 1
    iptables -F gms_wall 2>/dev/null || true
    ip6tables -F gms_wall 2>/dev/null || true
}
fail() {
    echo '{"status":"error","message":"Action failed; original settings backup retained"}'
    exit 1
}
json_string() {
    # Properties may contain quotes/control characters; escape JSON safely.
    printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g;s/"/\\"/g'
}
case "${1:-status}" in
    save_log)
        # User-requested local export only. No network, logcat or credentials.
        [ "${#2}" -le 98304 ] || fail
        _downloads=/storage/emulated/0/Download
        [ -d "$_downloads" ] && [ ! -L "$_downloads" ] || fail
        # mktemp creates an exclusive file: never overwrite an existing export.
        _log=$(mktemp "$_downloads/OneOne-FCM-$(date +%Y%m%d-%H%M%S)-XXXXXX.log") || fail
        if ! (
            printf 'OneOne FCM diagnostics\nGenerated: '; date -Iseconds
            printf '\nScope: module snapshot + retained WebUI session. No Android-wide logcat.\n'
            printf 'Contains package names/configuration/errors. Review before sharing.\n'
            printf '\n===== Module =====\n'; cat "$MODDIR/module.prop"
            printf '\n===== Device =====\n'
            for _prop in ro.product.manufacturer ro.product.model ro.product.device ro.build.version.incremental ro.build.version.sdk ro.build.version.security_patch; do
                printf '%s=%s\n' "$_prop" "$(getprop "$_prop")"
            done
            printf '\n===== Core =====\n'
            printf 'PowerKeeper GMS control: '; read_powerkeeper_control || true
            printf 'Boot preference: '; read_pk_boot_config; printf '%s\n' "$PK_GMS_BOOT"
            cmd deviceidle whitelist 2>&1
            for _op in RUN_IN_BACKGROUND RUN_ANY_IN_BACKGROUND 10008 WAKE_LOCK; do
                cmd appops get com.google.android.gms "$_op" 2>&1
            done
            printf '\n===== Framework =====\n'; fw_status; printf 'state=%s\n' "$FW_STATUS"
            for _file in "$FW_POLICY" "$FW_STATE/artifacts/manifest" "$FW_STATE/prepare.log"; do
                printf '\n--- %s ---\n' "$_file"
                if [ -f "$_file" ] && [ ! -L "$_file" ]; then cat "$_file"; else printf '(absent)\n'; fi
            done
            printf '\n===== WebUI session =====\n%s\n' "$2"
        ) > "$_log"; then
            rm -f "$_log"; fail
        fi
        printf '{"status":"ok","path":"%s"}\n' "$(json_string "$_log")"
        ;;
    app_catalog)
        # Fallback inventory only. The manager WebUI API supplies labels/icons.
        # No app_process/ActivityThread initialization and no app code is loaded.
        _apps=$(pm list packages --user 0 2>/dev/null) || fail
        _system_apps=$(pm list packages --user 0 -s 2>/dev/null) || fail
        [ -n "$_apps" ] || fail
        printf '%s\n' "$_apps" | awk -v system_apps="$_system_apps" '
            BEGIN {
                n=split(system_apps, system_list, "\n")
                for(i=1;i<=n;i++){sub(/^package:/,"",system_list[i]);is_system[system_list[i]]=1}
                first=1;printf "{\"status\":\"ok\",\"apps\":["
            }
            /^package:[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$/ {
                sub(/^package:/,""); if(seen[$0]++)next
                if(!first)printf ",";first=0
                printf "{\"user\":0,\"package\":\"%s\",\"name\":\"%s\",\"system\":%s,\"icon\":null}",$0,$0,is_system[$0]?"true":"false"
            }
            END {printf "]}\n"}
        '
        ;;
    whitelist_get)
        _list=$(grep -E '^0:[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$' "$FW_POLICY" 2>/dev/null | sort -u)
        printf '{"status":"ok","packages":"%s"}\n' "$(json_string "$(printf '%s' "$_list" | tr '\n' ',')")"
        ;;
    whitelist_save)
        _list=$(printf '%s' "$2" | tr ',' '\n')
        fw_write_policy list "$_list" || fail
        echo '{"status":"ok"}'
        ;;
    framework_status)
        fw_status
        _enabled=false; fw_requested && _enabled=true
        printf '{"status":"ok","framework":"%s","enabled":%s}\n' "$FW_STATUS" "$_enabled"
        ;;
    framework_enable)
        fw_write_policy enabled "$2" || fail
        echo '{"status":"ok","reboot_required":true}'
        ;;
    framework_prepare)
        fw_init && fw_supported || fail
        [ ! -e "$FW_STATE/prepare.lock" ] || fail
        # Detached worker owns its own pid/lock, log and atomic artifact transaction.
        sh "$MODDIR/framework-job.sh" > "$FW_STATE/prepare.log" 2>&1 < /dev/null &
        echo '{"status":"ok","started":true}'
        ;;
    status|load_status|get_status)
        read_pk_boot_config; get_pk_state
        _idle=$(cmd deviceidle whitelist 2>/dev/null); _idle_status=$?
        GMS_DOZE=unknown
        if [ "$_idle_status" -eq 0 ]; then
            GMS_DOZE=false
            printf '%s\n' "$_idle" | grep -q 'com.google.android.gms' && GMS_DOZE=true
        fi
        _firmware=$(json_string "$(getprop ro.build.version.incremental)")
        _version=$(sed -n 's/^version=//p' "$MODDIR/module.prop" | head -n1)
        printf '{"status":"ok","version":"%s","firmware":"%s","doze":"%s","gms_parity":{"powerkeeper_gms_control":"%s","boot_apply":%s}}\n' "$_version" "$_firmware" "$GMS_DOZE" "$PK_GMS_CTRL" "$PK_GMS_BOOT"
        ;;
    set_pk_gms|toggle_pk_gms)
        case "$2" in
            false) disarm_powerkeeper_gms || fail ;;
            true) restore_powerkeeper_state "$STOCK_CONF" >/dev/null 2>&1 || fail ;;
            *) fail ;;
        esac
        get_pk_state
        printf '{"status":"ok","powerkeeper_gms_control":"%s"}\n' "$PK_GMS_CTRL"
        ;;
    set_pk_gms_boot)
        case "$2" in true|false) TARGET="$2" ;; *) fail ;; esac
        [ "$TARGET" != true ] || disarm_powerkeeper_gms || fail
        printf '%s\n' "$TARGET" > "$PK_BOOT_CONF.tmp.$$" || fail
        set_data_permissions "$PK_BOOT_CONF.tmp.$$"
        mv -f "$PK_BOOT_CONF.tmp.$$" "$PK_BOOT_CONF" || fail
        get_pk_state
        printf '{"status":"ok","boot_apply":%s,"powerkeeper_gms_control":"%s"}\n' "$TARGET" "$PK_GMS_CTRL"
        ;;
    *) fail ;;
esac
